{
  "name": "rpg-image-tool-poc",
  "version": "0.4.0",
  "private": true,
  "description": "RPG Maker image tool development build",
  "main": "out/main/index.js",
  "author": "RPG Image Tool",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "native:electron": "electron-builder install-app-deps",
    "native:node": "npm rebuild better-sqlite3",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "format": "prettier --write src tests *.ts *.mts *.json .vscode/*.json",
    "format:check": "prettier --check src tests *.ts *.mts *.json .vscode/*.json"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "local.rpg-image-tool.poc",
    "productName": "RPG Image Tool PoC",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir"
    }
  }
}
